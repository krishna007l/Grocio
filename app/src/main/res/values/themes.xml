<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Grocio" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_white</item>
        <item name="colorSecondary">@color/color_green</item>
        <item name="colorOnSecondary">@color/color_white</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="android:colorBackground">@color/color_app_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/color_app_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="toolbarStyle">@style/Widget.Grocio.Toolbar</item>
    </style>

    <style name="Theme.Grocio" parent="Base.Theme.Grocio" />

    <style name="Widget.Grocio.Toolbar" parent="@style/Widget.Material3.Toolbar">
        <item name="android:background">@color/color_app_bg</item>
        <item name="titleTextColor">@color/color_text_primary</item>
        <item name="subtitleTextColor">@color/color_text_secondary</item>
    </style>
</resources>
