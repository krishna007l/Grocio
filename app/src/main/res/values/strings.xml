    <string name="str_support_subtitle">Reach Grocio support for deliveries, account help, and order issues.</string>
    <string name="str_support_body">Email support@grocio.com when you need help with delivery timing, missing items, address corrections, or payment concerns.\n\nSupport checklist:\n- Mention your order ID when available\n- Use the same email connected to your account\n- Describe the issue clearly so the team can respond faster</string>
    <string name="str_support_footer">Support hours: 8:00 AM to 9:00 PM every day. Delivery edits should be updated from the account screen before placing a fresh order.</string>
    <string name="str_help">Help</string>
    <string name="str_about">About</string>
    <string name="str_about_subtitle">Grocio is designed for everyday grocery browsing with a lighter, quicker shopping flow.</string>
    <string name="str_about_body">Grocio brings fresh produce, pantry staples, saved favourites, and repeat ordering into one clean experience.\n\nInside the app you can:\n- Browse a live grocery feed\n- Save items you like for later\n- Build a quick cart and place an order\n- Manage customer details and delivery address from one place</string>
    <string name="str_about_footer">Version 1.0. Grocio uses a warm white-orange interface to keep daily shopping simple and readable.</string>
    <string name="str_log_out">Log Out</string>
